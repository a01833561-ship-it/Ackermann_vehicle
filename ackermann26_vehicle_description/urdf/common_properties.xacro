<?xml version="1.0"?>
<!--Materials , Properties , Macros-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>

    <material name="green">
        <color rgba="0 0.5 0 1" />
    </material>

    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>

    <material name="black">
        <color rgba="0.05 0.05 0.05 1" />
    </material>

    <xacro:macro name="box_inertia" params="m l w h o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <mass value="${m}"/>
            <inertia ixx="${m*(w*w + h*h)/12.0}" ixy="0.0" ixz="0.0" iyy="${m*(l*l + h*h)/12.0}" iyz="0.0" izz="${m*(w*w + l*l)/12.0}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sphere_inertia" params="m r o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <mass value="${m}"/>
            <inertia ixx="${2*m*r*r/5}" ixy="0.0" ixz="0.0" 
                     iyy="${2*m*r*r/5}" iyz="0.0" 
                     izz="${2*m*r*r/5}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="cylinder_inertia" params="m r l o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <mass value="${m}"/>
            <inertia ixx="${m*(3*r*r + l*l)/12.0}" ixy="0.0" ixz="0.0" 
                     iyy="${m*(3*r*r + l*l)/12.0}" iyz="0.0" 
                     izz="${m*r*r/2.0}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="sensor_inertial" params="mass:=0.05 ixx:=0.0001 iyy:=0.0001 izz:=0.0001">
        <inertial>
            <mass value="${mass}"/>
            <inertia ixx="${ixx}" ixy="0" ixz="0" iyy="${iyy}" iyz="0" izz="${izz}"/>
            </inertial>
    </xacro:macro>

</robot>
