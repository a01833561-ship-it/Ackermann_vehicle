<?xml version="1.0"?>

<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

    <name>ackermann26_vehicle_gazebo</name>
    <version>0.0.0</version>
    <description>Gazebo simulation package for ackermann26 vehicle</description>
    <maintainer email="sina@todo.todo">sina</maintainer>
    <license>Apache-2.0</license>
    <buildtool_depend>ament_cmake</buildtool_depend>

    <!-- ROS 2 launch dependencies -->
    <exec_depend>launch</exec_depend>
    <!-- Robot state / Xacro -->
    <exec_depend>robot_state_publisher</exec_depend>
    <exec_depend>xacro</exec_depend>
    <!-- Gazebo Harmonic -->
    
    <exec_depend>ros_gz_sim</exec_depend>
    <!-- ROS 2 <-> Gazebo bridge -->
    <exec_depend>ros_gz_bridge</exec_depend>
    <!-- Optional: access package files from Python -->

    <exec_depend>ament_index_python</exec_depend>
    <test_depend>ament_lint_auto</test_depend>

    <test_depend>ament_lint_common</test_depend>
    <!-- Package type -->
    <export>
    <build_type>ament_cmake</build_type>
    </export>

</package>
